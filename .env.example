# CEASA Copacabana Backend - Variáveis de Ambiente

# Servidor
PORT=5000
NODE_ENV=development

# JWT Secret (gere um forte em produção)
JWT_SECRET=ceasa-super-secret-key-change-in-production-2024

# Groq API Key (para OCR de etiquetas via WhatsApp)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=sua_groq_api_key_aqui

# Mercado Pago (para pagamentos)
MERCADOPAGO_ACCESS_TOKEN=seu_access_token
MERCADOPAGO_PUBLIC_KEY=sua_public_key

# WhatsApp Business API (opcional - para envio automático de resposta)
WHATSAPP_TOKEN=seu_token_whatsapp
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id