generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("vendedor") // admin | vendedor
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Category {
  id   String @id @default(cuid())
  name String @unique // Normal, Proteico, Energetico, Isotonico
  slug String @unique

  products Product[]
}

model Product {
  id                  String  @id @default(cuid())
  name                String
  description         String?
  price               Float
  categoryId          String
  active              Boolean @default(true)
  costPerBatch        Float   @default(0) // custo por batelada (10 paletas)
  costPerUnit         Float   @default(0) // custo por paleta
  maxProduction       Int     @default(0) // producao maxima com estoque atual
  limitingIngredient  String? // ingrediente limitante

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category     @relation(fields: [categoryId], references: [id])
  stock       Stock?
  orderItems  OrderItem[]
  recipeItems RecipeItem[]
}

model Supply {
  id          String  @id @default(cuid())
  name        String
  unit        String  // kg, litros, unidades, gramas
  quantity    Float   @default(0)
  minStock    Float   @default(0)
  costPerUnit Float   @default(0) // custo por unidade (R$/kg, R$/un etc)
  totalCost   Float   @default(0) // custo total investido
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements   SupplyMovement[]
  recipeItems RecipeItem[]
}

model SupplyMovement {
  id       String   @id @default(cuid())
  supplyId String
  type     String   // entrada | saida
  quantity Float
  notes    String?
  date     DateTime @default(now())

  supply Supply @relation(fields: [supplyId], references: [id])
}

model Stock {
  id        String @id @default(cuid())
  productId String @unique
  quantity  Int    @default(0)
  minStock  Int    @default(0)

  updatedAt DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id])
  movements StockMovement[]
}

model StockMovement {
  id       String   @id @default(cuid())
  stockId  String
  type     String   // producao | venda | ajuste
  quantity Int
  notes    String?
  date     DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id])
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("pendente") // pendente | aprovado | separado | entregue | cancelado
  total     Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model RecipeItem {
  id             String @id @default(cuid())
  productId      String
  supplyId       String
  quantityPerBatch Float // quantidade do insumo por batelada (10 paletas)

  product Product @relation(fields: [productId], references: [id])
  supply  Supply  @relation(fields: [supplyId], references: [id])

  @@unique([productId, supplyId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
