generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("vendedor") // admin | vendedor
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  store       Store?       // loja associada ao vendedor
  commissions Commission[] // comissões recebidas
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  phone          String?
  cpf            String?  @unique
  tokens         Float    @default(0)
  referralCode   String   @unique // código para indicar amigos
  referredById   String?  // quem indicou este cliente
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referredBy     Customer?        @relation("Referrals", fields: [referredById], references: [id])
  referrals      Customer[]       @relation("Referrals")
  purchases      Purchase[]
  tokenHistory   TokenTransaction[]
  cards          CustomerCard[]
  battlesAs1     CardBattle[]     @relation("BattlePlayer1")
  battlesAs2     CardBattle[]     @relation("BattlePlayer2")
}

model Store {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String   @default("SP")
  phone       String?
  lat         Float?   // latitude para busca por proximidade
  lng         Float?   // longitude
  active      Boolean  @default(true)
  vendorId    String   @unique // vendedor responsável pela loja
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor      User           @relation(fields: [vendorId], references: [id])
  purchases   Purchase[]
  products    StoreProduct[]
}

model Purchase {
  id              String   @id @default(cuid())
  customerId      String
  storeId         String   // loja onde retira
  status          String   @default("pendente") // pendente | pago | separado | retirado | cancelado
  total           Float    @default(0)
  tokensEarned    Float    @default(0) // tokens ganhos nesta compra
  tokensUsed      Float    @default(0) // tokens usados como desconto
  commissionRate  Float    @default(0.15) // 15% comissão para vendedor
  commissionValue Float    @default(0)
  paymentId       String?  // ID do pagamento no Mercado Pago
  paymentStatus   String?  // status do pagamento MP
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer    Customer       @relation(fields: [customerId], references: [id])
  store       Store          @relation(fields: [storeId], references: [id])
  items       PurchaseItem[]
  commission  Commission?
}

model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  price      Float

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model TokenTransaction {
  id         String   @id @default(cuid())
  customerId String
  type       String   // compra | indicacao | resgate | bonus
  amount     Float    // positivo = ganho, negativo = gasto
  description String
  purchaseId String?  // compra associada (se houver)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model Commission {
  id         String   @id @default(cuid())
  purchaseId String   @unique
  vendorId   String
  amount     Float
  status     String   @default("pendente") // pendente | liberada | paga
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  vendor   User     @relation(fields: [vendorId], references: [id])
}

model Category {
  id   String @id @default(cuid())
  name String @unique // Normal, Proteico, Energetico, Isotonico
  slug String @unique

  products Product[]
}

model Product {
  id                  String  @id @default(cuid())
  name                String
  description         String?
  price               Float
  categoryId          String
  active              Boolean @default(true)
  costPerBatch        Float   @default(0) // custo por batelada (10 paletas)
  costPerUnit         Float   @default(0) // custo por paleta
  maxProduction       Int     @default(0) // producao maxima com estoque atual
  limitingIngredient  String? // ingrediente limitante

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  stock         Stock?
  orderItems    OrderItem[]
  recipeItems   RecipeItem[]
  purchaseItems PurchaseItem[]
  storeProducts StoreProduct[]
}

model Supply {
  id          String  @id @default(cuid())
  name        String
  unit        String  // kg, litros, unidades, gramas
  quantity    Float   @default(0)
  minStock    Float   @default(0)
  costPerUnit Float   @default(0) // custo por unidade (R$/kg, R$/un etc)
  totalCost   Float   @default(0) // custo total investido
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements   SupplyMovement[]
  recipeItems RecipeItem[]
}

model SupplyMovement {
  id       String   @id @default(cuid())
  supplyId String
  type     String   // entrada | saida
  quantity Float
  notes    String?
  date     DateTime @default(now())

  supply Supply @relation(fields: [supplyId], references: [id])
}

model Stock {
  id        String @id @default(cuid())
  productId String @unique
  quantity  Int    @default(0)
  minStock  Int    @default(0)

  updatedAt DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id])
  movements StockMovement[]
}

model StockMovement {
  id       String   @id @default(cuid())
  stockId  String
  type     String   // producao | venda | ajuste
  quantity Int
  notes    String?
  date     DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id])
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("pendente") // pendente | aprovado | separado | entregue | cancelado
  total     Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model RecipeItem {
  id             String @id @default(cuid())
  productId      String
  supplyId       String
  quantityPerBatch Float // quantidade do insumo por batelada (10 paletas)

  product Product @relation(fields: [productId], references: [id])
  supply  Supply  @relation(fields: [supplyId], references: [id])

  @@unique([productId, supplyId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model StoreProduct {
  id        String  @id @default(cuid())
  storeId   String
  productId String
  price     Float?  // preço customizado (null = usa preço padrão)
  available Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
}

// ========================================
// LIGA DAS PALETAS - Sistema de Colecionáveis
// ========================================

model Season {
  id          String   @id @default(cuid())
  name        String   // "Temporada 1 - Origens"
  number      Int      @unique // 1, 2, 3...
  totalCards  Int      @default(100)
  active      Boolean  @default(true)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())

  cards       Card[]
}

model Faction {
  id          String @id @default(cuid())
  name        String @unique // "Frutas", "Creme", "Gelada"
  description String?
  color       String @default("#8B5CF6") // hex color for UI
  icon        String @default("⚔️")

  cards       Card[]
}

model Card {
  id              String @id @default(cuid())
  seasonId        String
  factionId       String
  collectionNumber Int   // #001 - #100
  name            String // "SAMURAI DO AÇAÍ"
  element         String // "Fruta Sombria"
  attack          Int    @default(50)
  defense         Int    @default(50)
  rarity          String // comum | raro | holografico | lendario | secreto
  description     String?
  imageUrl        String? // URL da imagem do personagem
  qrCode          String  @unique // código único para scan
  tokenReward     Int     @default(1) // tokens ao escanear
  totalPrinted    Int     @default(0) // total impresso
  active          Boolean @default(true)
  createdAt       DateTime @default(now())

  season          Season         @relation(fields: [seasonId], references: [id])
  faction         Faction        @relation(fields: [factionId], references: [id])
  customerCards   CustomerCard[]

  @@unique([seasonId, collectionNumber])
}

model CustomerCard {
  id          String   @id @default(cuid())
  customerId  String
  cardId      String
  scannedAt   DateTime @default(now())
  isDuplicate Boolean  @default(false) // se já tinha essa carta

  customer    Customer @relation(fields: [customerId], references: [id])
  card        Card     @relation(fields: [cardId], references: [id])
}

model CardBattle {
  id          String   @id @default(cuid())
  player1Id   String
  player2Id   String
  winnerId    String?  // null = empate
  player1Score Int     @default(0)
  player2Score Int     @default(0)
  player1Cards String  // JSON array of card IDs
  player2Cards String  // JSON array of card IDs
  status      String   @default("pendente") // pendente | aceito | concluido | recusado
  createdAt   DateTime @default(now())

  player1     Customer @relation("BattlePlayer1", fields: [player1Id], references: [id])
  player2     Customer @relation("BattlePlayer2", fields: [player2Id], references: [id])
}

model GoldenStick {
  id          String   @id @default(cuid())
  code        String   @unique // "GOLD-001"
  edition     String   // "Edição 1/500"
  prize       String   // descrição do prêmio
  prizeType   String   // caixa | freezer | dinheiro | tokens
  prizeValue  Float    @default(0) // valor em R$ ou tokens
  claimed     Boolean  @default(false)
  claimedById String?  // customer que resgatou
  claimedAt   DateTime?
  createdAt   DateTime @default(now())
}
